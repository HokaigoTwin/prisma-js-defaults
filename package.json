{
  "name": "prisma-js-defaults",
  "version": "2.1.0",
  "description": "Zero-dependency Prisma extension to generate default values using custom JavaScript functions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "prisma-js-defaults": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npx tsx src/cli.ts && vitest run --fileParallelism false"
  },
  "keywords": [
    "prisma",
    "prisma-extension",
    "default",
    "generator",
    "orm",
    "database"
  ],
  "author": "Daniil Didenko <hokaitwin@gmail.com> (https://github.com/HokaigoTwin)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@prisma/client": ">=4.0.0",
    "prisma": ">=4.0.0"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@prisma/internals": "^7.8.0"
  }
}
